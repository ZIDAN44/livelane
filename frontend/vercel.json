{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.onrender.com/api/:path*" },
    { "source": "/actuator/:path*", "destination": "https://YOUR-BACKEND.onrender.com/actuator/:path*" },
    { "source": "/swagger-ui", "destination": "https://YOUR-BACKEND.onrender.com/swagger-ui" },
    { "source": "/swagger-ui/:path*", "destination": "https://YOUR-BACKEND.onrender.com/swagger-ui/:path*" },
    { "source": "/v3/api-docs/:path*", "destination": "https://YOUR-BACKEND.onrender.com/v3/api-docs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
