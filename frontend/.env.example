# Leave VITE_API_URL empty to call the API on the same origin (Vite proxy locally, vercel.json rewrites in prod).
VITE_API_URL=
# WebSockets can't go through Vercel rewrites - point straight at the backend in production:
# VITE_WS_URL=wss://YOUR-BACKEND.onrender.com/ws
VITE_WS_URL=
# Optional: shows a "Source" link on the login page.
VITE_REPO_URL=https://github.com/ZIDAN44/tpm
